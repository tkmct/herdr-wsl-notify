# Copy to "$(herdr plugin config-dir tkmct.wsl-notify)/.env" and edit.
# Every setting is optional; the defaults below are what you get without a .env.

# Agent statuses that trigger a toast (comma separated: done, blocked, idle).
NOTIFY_ON=done,blocked

# Skip notifications for the pane you are currently focused on (1/0).
SKIP_FOCUSED=1

# Suppress repeated toasts for the same pane + status within this window (ms).
DEBOUNCE_MS=3000

# Override the Windows PowerShell path (normally auto-detected).
#POWERSHELL_EXE=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe

# Override the AppUserModelID used as the toast sender identity.
#TOAST_APP_ID={1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\WindowsPowerShell\v1.0\powershell.exe

# Default enabled state when no toggle state file exists yet (1/0).
#HERDR_WSL_NOTIFY_ENABLED=1

# Dump the raw herdr event/context JSON to the plugin log for troubleshooting.
#DEBUG_EVENT=1
